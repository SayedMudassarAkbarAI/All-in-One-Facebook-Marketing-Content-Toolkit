# ==============================================================================
# All-in-One Facebook Marketing & Content Toolkit — Environment Configuration
# ==============================================================================

# Application URL (configured automatically on Vercel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database (Prisma ORM)
# Compatible with Neon, Supabase, Vercel Postgres, or local PostgreSQL
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/facebook_toolkit?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://user:password@localhost:5432/facebook_toolkit?schema=public"

# ------------------------------------------------------------------------------
# 2. Upstash Redis (Rate limiting, caching, and serverless queues)
# Sign up free at https://upstash.com
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ------------------------------------------------------------------------------
# 3. Meta / Facebook Graph API Credentials
# Create app at https://developers.facebook.com
# ------------------------------------------------------------------------------
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_secret_verification_token"
NEXT_PUBLIC_META_OAUTH_REDIRECT_URI="http://localhost:3000/auth/facebook/callback"

# ------------------------------------------------------------------------------
# 4. Token Encryption Key (AES-256-GCM)
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
ENCRYPTION_SECRET_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 5. Media & Storage
# Vercel Blob (default) or AWS S3 / Cloudflare R2
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"

# ------------------------------------------------------------------------------
# 6. Optional AI Engine Provider Overrides
# Leave blank to use deterministic high-converting built-in template engine
# ------------------------------------------------------------------------------
AI_API_KEY=""
AI_PROVIDER="template" # options: template | openai | gemini | anthropic

# ------------------------------------------------------------------------------
# 7. Vercel Cron Secret (protects /api/cron/* endpoints)
# ------------------------------------------------------------------------------
CRON_SECRET="custom_cron_security_secret"
